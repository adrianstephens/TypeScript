// Vector class for additional testing
class Vector {
>Vector : Vector
>       : ^^^^^^

    constructor(public values: number[]) {}
>values : number[]
>       : ^^^^^^^^
    
    add(other: Vector): Vector {
>add : (other: Vector) => Vector
>    : ^     ^^      ^^^^^      
>other : Vector
>      : ^^^^^^

        return new Vector(this.values.map((v, i) => v + other.values[i]));
>new Vector(this.values.map((v, i) => v + other.values[i])) : Vector
>                                                           : ^^^^^^
>Vector : typeof Vector
>       : ^^^^^^^^^^^^^
>this.values.map((v, i) => v + other.values[i]) : number[]
>                                               : ^^^^^^^^
>this.values.map : <U>(callbackfn: (value: number, index: number, array: number[]) => U, thisArg?: any) => U[]
>                : ^ ^^          ^^^     ^^^^^^^^^^     ^^      ^^     ^^^^^^^^^^^^^^^^^^       ^^^   ^^^^^^^^
>this.values : number[]
>            : ^^^^^^^^
>this : this
>     : ^^^^
>values : number[]
>       : ^^^^^^^^
>map : <U>(callbackfn: (value: number, index: number, array: number[]) => U, thisArg?: any) => U[]
>    : ^ ^^          ^^^     ^^^^^^^^^^     ^^      ^^     ^^^^^^^^^^^^^^^^^^       ^^^   ^^^^^^^^
>(v, i) => v + other.values[i] : (v: number, i: number) => number
>                              : ^ ^^^^^^^^^^ ^^^^^^^^^^^^^^^^^^^
>v : number
>  : ^^^^^^
>i : number
>  : ^^^^^^
>v + other.values[i] : number
>                    : ^^^^^^
>v : number
>  : ^^^^^^
>other.values[i] : number
>                : ^^^^^^
>other.values : number[]
>             : ^^^^^^^^
>other : Vector
>      : ^^^^^^
>values : number[]
>       : ^^^^^^^^
>i : number
>  : ^^^^^^
    }
    
    mul(scalar: number): Vector {
>mul : (scalar: number) => Vector
>    : ^      ^^      ^^^^^      
>scalar : number
>       : ^^^^^^

        return new Vector(this.values.map(v => v * scalar));
>new Vector(this.values.map(v => v * scalar)) : Vector
>                                             : ^^^^^^
>Vector : typeof Vector
>       : ^^^^^^^^^^^^^
>this.values.map(v => v * scalar) : number[]
>                                 : ^^^^^^^^
>this.values.map : <U>(callbackfn: (value: number, index: number, array: number[]) => U, thisArg?: any) => U[]
>                : ^ ^^          ^^^     ^^^^^^^^^^     ^^      ^^     ^^^^^^^^^^^^^^^^^^       ^^^   ^^^^^^^^
>this.values : number[]
>            : ^^^^^^^^
>this : this
>     : ^^^^
>values : number[]
>       : ^^^^^^^^
>map : <U>(callbackfn: (value: number, index: number, array: number[]) => U, thisArg?: any) => U[]
>    : ^ ^^          ^^^     ^^^^^^^^^^     ^^      ^^     ^^^^^^^^^^^^^^^^^^       ^^^   ^^^^^^^^
>v => v * scalar : (v: number) => number
>                : ^ ^^^^^^^^^^^^^^^^^^^
>v : number
>  : ^^^^^^
>v * scalar : number
>           : ^^^^^^
>v : number
>  : ^^^^^^
>scalar : number
>       : ^^^^^^
    }
    
    eq(other: Vector): boolean {
>eq : (other: Vector) => boolean
>   : ^     ^^      ^^^^^       
>other : Vector
>      : ^^^^^^

        return this.values.every((v, i) => v === other.values[i]);
>this.values.every((v, i) => v === other.values[i]) : boolean
>                                                   : ^^^^^^^
>this.values.every : { <S extends number>(predicate: (value: number, index: number, array: number[]) => value is S, thisArg?: any): this is S[]; (predicate: (value: number, index: number, array: number[]) => unknown, thisArg?: any): boolean; }
>                  : ^^^ ^^^^^^^^^^^^^^^^^         ^^^     ^^^^^^^^^^     ^^      ^^     ^^^^^^^^^^^^^^^^^^^^^^^^^^^       ^^^   ^^^        ^  ^^^         ^^^     ^^^^^^^^^^     ^^      ^^     ^^^^^^^^^^^^^^^       ^^       ^^^   ^^^       ^^^
>this.values : number[]
>            : ^^^^^^^^
>this : this
>     : ^^^^
>values : number[]
>       : ^^^^^^^^
>every : { <S extends number>(predicate: (value: number, index: number, array: number[]) => value is S, thisArg?: any): this is S[]; (predicate: (value: number, index: number, array: number[]) => unknown, thisArg?: any): boolean; }
>      : ^^^ ^^^^^^^^^^^^^^^^^         ^^^     ^^^^^^^^^^     ^^      ^^     ^^^^^^^^^^^^^^^^^^^^^^^^^^^       ^^^   ^^^        ^  ^^^         ^^^     ^^^^^^^^^^     ^^      ^^     ^^^^^^^^^^^^^^^       ^^       ^^^   ^^^       ^^^
>(v, i) => v === other.values[i] : (v: number, i: number) => boolean
>                                : ^ ^^^^^^^^^^ ^^^^^^^^^^^^^^^^^^^^
>v : number
>  : ^^^^^^
>i : number
>  : ^^^^^^
>v === other.values[i] : boolean
>                      : ^^^^^^^
>v : number
>  : ^^^^^^
>other.values[i] : number
>                : ^^^^^^
>other.values : number[]
>             : ^^^^^^^^
>other : Vector
>      : ^^^^^^
>values : number[]
>       : ^^^^^^^^
>i : number
>  : ^^^^^^
    }
}

// Usage examples - should be transformed to method calls
const p1 = new Point(1, 2);
>p1 : Point
>   : ^^^^^
>new Point(1, 2) : Point
>                : ^^^^^
>Point : typeof Point
>      : ^^^^^^^^^^^^
>1 : 1
>  : ^
>2 : 2
>  : ^

const p2 = new Point(3, 4);
>p2 : Point
>   : ^^^^^
>new Point(3, 4) : Point
>                : ^^^^^
>Point : typeof Point
>      : ^^^^^^^^^^^^
>3 : 3
>  : ^
>4 : 4
>  : ^

// Binary arithmetic operators
const p3 = p1 + p2;        // Should become: p1.add(p2)
>p3 : any
>   : ^^^
>p1 + p2 : any
>        : ^^^
>p1 : Point
>   : ^^^^^
>p2 : Point
>   : ^^^^^

const p4 = p1 - p2;        // Should become: p1.sub(p2)
>p4 : Point
>   : ^^^^^
>p1 - p2 : Point
>        : ^^^^^
>p1 : Point
>   : ^^^^^
>p2 : Point
>   : ^^^^^

const p5 = p1 * p2;        // Should become: p1.mul(p2)
>p5 : Point
>   : ^^^^^
>p1 * p2 : Point
>        : ^^^^^
>p1 : Point
>   : ^^^^^
>p2 : Point
>   : ^^^^^

const p6 = p1 / p2;        // Should become: p1.div(p2)
>p6 : Point
>   : ^^^^^
