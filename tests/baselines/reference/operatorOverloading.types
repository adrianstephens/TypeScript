//// [tests/cases/compiler/operatorOverloading.ts] ////

=== operatorOverloading.ts ===
// Test operator overloading transformation

// Interface for addable types
interface Addable<T> {
    add(other: T): T;
>add : (other: T) => T
>    : ^     ^^ ^^^^^ 
>other : T
>      : ^
}

// Point class with comprehensive operator overloads
class Point implements Addable<Point> {
>Point : Point
>      : ^^^^^

    constructor(public x: number, public y: number) {}
>x : number
>  : ^^^^^^
>y : number
>  : ^^^^^^
    
    // Addition overloads
    add(other: number): Point {
>add : (other: number) => Point
>    : ^     ^^      ^^^^^     
>other : number
>      : ^^^^^^

        return new Point(this.x + other, this.y + other);
>new Point(this.x + other, this.y + other) : Point
>                                          : ^^^^^
>Point : typeof Point
>      : ^^^^^^^^^^^^
>this.x + other : number
>               : ^^^^^^
>this.x : number
>       : ^^^^^^
>this : this
>     : ^^^^
>x : number
>  : ^^^^^^
>other : number
>      : ^^^^^^
>this.y + other : number
>               : ^^^^^^
>this.y : number
>       : ^^^^^^
>this : this
>     : ^^^^
>y : number
>  : ^^^^^^
>other : number
>      : ^^^^^^
    }
    
    add(other: Point): Point {
>add : (other: number) => Point
>    : ^     ^^      ^^^^^     
>other : Point
>      : ^^^^^

        return new Point(this.x + other.x, this.y + other.y);
>new Point(this.x + other.x, this.y + other.y) : Point
>                                              : ^^^^^
>Point : typeof Point
>      : ^^^^^^^^^^^^
>this.x + other.x : number
>                 : ^^^^^^
>this.x : number
>       : ^^^^^^
>this : this
>     : ^^^^
>x : number
>  : ^^^^^^
>other.x : number
>        : ^^^^^^
>other : Point
>      : ^^^^^
>x : number
>  : ^^^^^^
>this.y + other.y : number
>                 : ^^^^^^
>this.y : number
>       : ^^^^^^
>this : this
>     : ^^^^
>y : number
>  : ^^^^^^
>other.y : number
>        : ^^^^^^
>other : Point
>      : ^^^^^
>y : number
>  : ^^^^^^
    }
    
    // Subtraction overloads
    sub(other: Point): Point {
>sub : (other: Point) => Point
>    : ^     ^^     ^^^^^     
>other : Point
>      : ^^^^^

        return new Point(this.x - other.x, this.y - other.y);
>new Point(this.x - other.x, this.y - other.y) : Point
>                                              : ^^^^^
>Point : typeof Point
>      : ^^^^^^^^^^^^
>this.x - other.x : number
>                 : ^^^^^^
>this.x : number
>       : ^^^^^^
>this : this
>     : ^^^^
>x : number
>  : ^^^^^^
>other.x : number
>        : ^^^^^^
>other : Point
>      : ^^^^^
>x : number
>  : ^^^^^^
>this.y - other.y : number
>                 : ^^^^^^
>this.y : number
>       : ^^^^^^
>this : this
>     : ^^^^
>y : number
>  : ^^^^^^
>other.y : number
>        : ^^^^^^
>other : Point
>      : ^^^^^
>y : number
>  : ^^^^^^
    }
    
    sub(other: number): Point {
>sub : (other: Point) => Point
>    : ^     ^^     ^^^^^     
>other : number
>      : ^^^^^^

        return new Point(this.x - other, this.y - other);
>new Point(this.x - other, this.y - other) : Point
>                                          : ^^^^^
>Point : typeof Point
>      : ^^^^^^^^^^^^
>this.x - other : number
>               : ^^^^^^
>this.x : number
>       : ^^^^^^
>this : this
>     : ^^^^
>x : number
>  : ^^^^^^
>other : number
>      : ^^^^^^
>this.y - other : number
>               : ^^^^^^
>this.y : number
>       : ^^^^^^
>this : this
>     : ^^^^
>y : number
>  : ^^^^^^
>other : number
>      : ^^^^^^
    }
    
    // Right-hand subtraction (for when Point is on right side)
    rsub(other: number): Point {
>rsub : (other: number) => Point
>     : ^     ^^      ^^^^^     
>other : number
>      : ^^^^^^

        return new Point(other - this.x, other - this.y);
>new Point(other - this.x, other - this.y) : Point
>                                          : ^^^^^
>Point : typeof Point
>      : ^^^^^^^^^^^^
>other - this.x : number
>               : ^^^^^^
>other : number
>      : ^^^^^^
>this.x : number
>       : ^^^^^^
>this : this
>     : ^^^^
>x : number
>  : ^^^^^^
>other - this.y : number
>               : ^^^^^^
>other : number
>      : ^^^^^^
>this.y : number
>       : ^^^^^^
>this : this
>     : ^^^^
>y : number
>  : ^^^^^^
    }
    
    // Multiplication overloads
    mul(other: Point): Point {
>mul : (other: Point) => Point
>    : ^     ^^     ^^^^^     
>other : Point
>      : ^^^^^

        return new Point(this.x * other.x, this.y * other.y);
>new Point(this.x * other.x, this.y * other.y) : Point
>                                              : ^^^^^
>Point : typeof Point
>      : ^^^^^^^^^^^^
>this.x * other.x : number
>                 : ^^^^^^
>this.x : number
>       : ^^^^^^
>this : this
>     : ^^^^
>x : number
>  : ^^^^^^
>other.x : number
>        : ^^^^^^
>other : Point
>      : ^^^^^
>x : number
>  : ^^^^^^
>this.y * other.y : number
>                 : ^^^^^^
>this.y : number
>       : ^^^^^^
>this : this
>     : ^^^^
>y : number
>  : ^^^^^^
>other.y : number
>        : ^^^^^^
>other : Point
>      : ^^^^^
>y : number
>  : ^^^^^^
    }
    
    mul(other: number): Point {
>mul : (other: Point) => Point
>    : ^     ^^     ^^^^^     
>other : number
>      : ^^^^^^

        return new Point(this.x * other, this.y * other);
>new Point(this.x * other, this.y * other) : Point
>                                          : ^^^^^
>Point : typeof Point
>      : ^^^^^^^^^^^^
>this.x * other : number
>               : ^^^^^^
>this.x : number
>       : ^^^^^^
>this : this
>     : ^^^^
>x : number
>  : ^^^^^^
>other : number
>      : ^^^^^^
>this.y * other : number
>               : ^^^^^^
>this.y : number
>       : ^^^^^^
>this : this
>     : ^^^^
>y : number
>  : ^^^^^^
>other : number
>      : ^^^^^^
    }
    
    // Division overloads
    div(other: Point): Point {
>div : (other: Point) => Point
>    : ^     ^^     ^^^^^     
>other : Point
>      : ^^^^^

        return new Point(this.x / other.x, this.y / other.y);
>new Point(this.x / other.x, this.y / other.y) : Point
>                                              : ^^^^^
>Point : typeof Point
>      : ^^^^^^^^^^^^
>this.x / other.x : number
>                 : ^^^^^^
>this.x : number
>       : ^^^^^^
>this : this
>     : ^^^^
>x : number
>  : ^^^^^^
>other.x : number
>        : ^^^^^^
>other : Point
>      : ^^^^^
>x : number
>  : ^^^^^^
>this.y / other.y : number
>                 : ^^^^^^
>this.y : number
>       : ^^^^^^
>this : this
>     : ^^^^
>y : number
>  : ^^^^^^
>other.y : number
>        : ^^^^^^
>other : Point
>      : ^^^^^
>y : number
>  : ^^^^^^
    }
    
    div(other: number): Point {
>div : (other: Point) => Point
>    : ^     ^^     ^^^^^     
>other : number
>      : ^^^^^^

        return new Point(this.x / other, this.y / other);
>new Point(this.x / other, this.y / other) : Point
>                                          : ^^^^^
>Point : typeof Point
>      : ^^^^^^^^^^^^
>this.x / other : number
>               : ^^^^^^
>this.x : number
>       : ^^^^^^
>this : this
>     : ^^^^
>x : number
>  : ^^^^^^
>other : number
>      : ^^^^^^
>this.y / other : number
>               : ^^^^^^
>this.y : number
>       : ^^^^^^
>this : this
>     : ^^^^
>y : number
>  : ^^^^^^
>other : number
>      : ^^^^^^
    }
    
    // Modulus overload
    mod(other: Point): Point {
>mod : (other: Point) => Point
>    : ^     ^^     ^^^^^     
>other : Point
>      : ^^^^^

        return new Point(this.x % other.x, this.y % other.y);
>new Point(this.x % other.x, this.y % other.y) : Point
>                                              : ^^^^^
>Point : typeof Point
>      : ^^^^^^^^^^^^
>this.x % other.x : number
>                 : ^^^^^^
>this.x : number
>       : ^^^^^^
>this : this
>     : ^^^^
>x : number
>  : ^^^^^^
>other.x : number
>        : ^^^^^^
>other : Point
>      : ^^^^^
>x : number
>  : ^^^^^^
>this.y % other.y : number
>                 : ^^^^^^
>this.y : number
>       : ^^^^^^
>this : this
>     : ^^^^
>y : number
>  : ^^^^^^
>other.y : number
>        : ^^^^^^
>other : Point
>      : ^^^^^
>y : number
>  : ^^^^^^
    }
    
    // Logical NOT overload
    not(): Point {
>not : () => Point
>    : ^^^^^^     

        return new Point(this.x === 0 ? 1 : 0, this.y === 0 ? 1 : 0);
>new Point(this.x === 0 ? 1 : 0, this.y === 0 ? 1 : 0) : Point
>                                                      : ^^^^^
>Point : typeof Point
>      : ^^^^^^^^^^^^
>this.x === 0 ? 1 : 0 : 0 | 1
>                     : ^^^^^
>this.x === 0 : boolean
>             : ^^^^^^^
>this.x : number
>       : ^^^^^^
>this : this
>     : ^^^^
>x : number
>  : ^^^^^^
>0 : 0
>  : ^
>1 : 1
>  : ^
>0 : 0
>  : ^
>this.y === 0 ? 1 : 0 : 0 | 1
>                     : ^^^^^
>this.y === 0 : boolean
>             : ^^^^^^^
>this.y : number
>       : ^^^^^^
>this : this
>     : ^^^^
>y : number
>  : ^^^^^^
>0 : 0
>  : ^
>1 : 1
>  : ^
>0 : 0
>  : ^
    }
    
    // Comparison overloads
    cmp(other: Point): number {
>cmp : (other: Point) => number
>    : ^     ^^     ^^^^^      
>other : Point
>      : ^^^^^

        return this.x === other.x ? (this.y - other.y) : (this.x - other.x);
>this.x === other.x ? (this.y - other.y) : (this.x - other.x) : number
>                                                             : ^^^^^^
>this.x === other.x : boolean
>                   : ^^^^^^^
>this.x : number
>       : ^^^^^^
>this : this
>     : ^^^^
>x : number
>  : ^^^^^^
>other.x : number
>        : ^^^^^^
>other : Point
>      : ^^^^^
>x : number
>  : ^^^^^^
>(this.y - other.y) : number
>                   : ^^^^^^
>this.y - other.y : number
>                 : ^^^^^^
>this.y : number
>       : ^^^^^^
>this : this
>     : ^^^^
>y : number
>  : ^^^^^^
>other.y : number
>        : ^^^^^^
>other : Point
>      : ^^^^^
>y : number
>  : ^^^^^^
>(this.x - other.x) : number
>                   : ^^^^^^
>this.x - other.x : number
>                 : ^^^^^^
>this.x : number
>       : ^^^^^^
>this : this
>     : ^^^^
>x : number
>  : ^^^^^^
>other.x : number
>        : ^^^^^^
>other : Point
>      : ^^^^^
>x : number
>  : ^^^^^^
    }
    
    eq(other: Point): boolean {
>eq : (other: Point) => boolean
>   : ^     ^^     ^^^^^       
>other : Point
>      : ^^^^^

        return this.x === other.x && this.y === other.y;
>this.x === other.x && this.y === other.y : boolean
>                                         : ^^^^^^^
>this.x === other.x : boolean
>                   : ^^^^^^^
>this.x : number
>       : ^^^^^^
>this : this
>     : ^^^^
>x : number
>  : ^^^^^^
>other.x : number
>        : ^^^^^^
>other : Point
>      : ^^^^^
>x : number
>  : ^^^^^^
>this.y === other.y : boolean
>                   : ^^^^^^^
>this.y : number
>       : ^^^^^^
>this : this
>     : ^^^^
>y : number
>  : ^^^^^^
>other.y : number
>        : ^^^^^^
>other : Point
>      : ^^^^^
>y : number
>  : ^^^^^^
    }
    
    ne(other: Point): boolean {
>ne : (other: Point) => boolean
>   : ^     ^^     ^^^^^       
>other : Point
>      : ^^^^^

        return this.x !== other.x || this.y !== other.y;
>this.x !== other.x || this.y !== other.y : boolean
>                                         : ^^^^^^^
>this.x !== other.x : boolean
>                   : ^^^^^^^
>this.x : number
